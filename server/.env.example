# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/whiteboard?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/collaborative-whiteboard
# If left blank, server automatically runs with resilient persistent local store (.data/store.json)
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=replace_with_your_strong_secret_key_or_random_bytes

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# AI Provider API Keys (Optional - Intelligent semantic architecture synthesis generator operates out-of-the-box if omitted)
# Google Gemini API Key
GEMINI_API_KEY=
# OpenAI API Key
OPENAI_API_KEY=
# Generic AI API Key
AI_API_KEY=
